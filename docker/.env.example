# Copy this file to docker/.env (which git ignores) and change the values.
# Compose refuses to start until JWT_SECRET and BOOTSTRAP_ADMIN_PASSWORD are set.

# Signs and verifies every login token. At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me-0000

# The first administrator, created on startup if it does not exist yet.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@arizona.edu
BOOTSTRAP_ADMIN_PASSWORD=change-me-Admin-123

# Where the frontend is served from: used for the reset link in the password reminder email and for CORS.
FRONTEND_URL=http://localhost:5500
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
